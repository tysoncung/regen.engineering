{
  // A small Worker in front of static assets. It exists for one reason: the
  // zone-level "Always Use HTTPS" setting does not apply to Workers custom
  // domains, so the HTTP to HTTPS redirect has to happen here. Everything else
  // falls through to the prerendered files via the ASSETS binding.
  //
  // This file must exist. Without it, `wrangler deploy` runs auto-config, which
  // installs @astrojs/cloudflare and prerenders through workerd, and that fails
  // when the generated compatibility date is newer than the build image runtime.
  "name": "regen-engineering",
  "compatibility_date": "2026-06-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
