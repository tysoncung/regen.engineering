---
import { Content } from '../../MANIFESTO.md'
import '../styles/global.css'

const title = 'Regen Engineering: knowledge is the asset, code is the byproduct'
const description =
  'An open methodology for owning software as knowledge. The system knowledge is the versioned, governed source; implementations are verified build artifacts that any capable AI can regenerate, at the smallest scope, on any stack.'
const site = 'https://regen.engineering'
const repo = 'https://github.com/tysoncung/regen.engineering'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Regen Engineering" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>

  <body>
    <div class="wrap">
      <header class="topbar">
        <a class="wordmark" href="/">Regen<span>&nbsp;Engineering</span></a>
        <nav>
          <a href={repo}>GitHub</a>
        </nav>
      </header>

      <article class="prose">
        <Content />
      </article>
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Regen Engineering is an open methodology, version 0.1, and is meant to be argued with.
          Proposals and corrections are welcome on <a href={repo}>GitHub</a>.
        </p>
        <p>Text licensed <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</p>
      </div>
    </footer>
  </body>
</html>
