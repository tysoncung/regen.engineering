---
// The manifesto markdown at the repository root is the single source of the
// text. It is rendered here rather than copied, so there is no second version
// to drift out of date. A manifesto about knowledge drift should not have any.
import { Content } from '../../MANIFESTO.md'
import Page from '../layouts/Page.astro'

const description =
  'An open methodology for owning software as knowledge. The system knowledge is the versioned, governed source; implementations are verified build artifacts that any capable AI can regenerate, at the smallest scope, on any stack.'
---

<Page title="Regen Engineering" description={description} variant="manifesto">
  <Content />
</Page>
